<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/all_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- Hidden legacy quick-menu container: kept for Java compatibility (fragments collapse it) -->
    <net.cachapa.expandablelayout.ExpandableLayout
        android:id="@+id/menu_expand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:el_expanded="false" />

    <!-- Full-bleed fragment container — no App Bar / header, content runs edge to edge -->
    <FrameLayout
        android:id="@+id/flContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_nav" />

    <!-- ============ STYLISH ANIMATED BOTTOM NAVIGATION BAR ============ -->
    <FrameLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_nav_bar"
        android:elevation="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- Animated neon gradient indicator pill -->
        <View
            android:id="@+id/nav_indicator"
            android:layout_width="56dp"
            android:layout_height="34dp"
            android:layout_gravity="top|start"
            android:background="@drawable/bg_nav_indicator"
            android:elevation="2dp" />

        <!-- Icon-only nav items (no text labels) -->
        <LinearLayout
            android:id="@+id/bottom_nav_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nav_dashboard"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/home"
                    android:tint="@color/nav_icon"
                    android:contentDescription="@string/dashboard" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_wifi"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/wifi"
                    android:tint="@color/nav_icon"
                    android:contentDescription="@string/wifi_networks" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_portal"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/website"
                    android:tint="@color/nav_icon"
                    android:contentDescription="Portal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_twin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/wifi3"
                    android:tint="@color/nav_icon"
                    android:contentDescription="@string/evil_twin" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/settings"
                    android:tint="@color/nav_icon"
                    android:contentDescription="@string/app_setting" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
