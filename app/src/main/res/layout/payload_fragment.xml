<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:src="@drawable/msf"
            android:tint="@color/blue2" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lhost_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/lhost"
            app:hintEnabled="true"
            app:hintTextColor="#FF676262">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lhost_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lport_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/lport"
            app:hintEnabled="true"
            app:hintTextColor="#FF676262">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lport_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/payload_type"
            android:textColor="@color/textcolor"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/payload_spinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/spinner_bg"
            android:popupBackground="#222222" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/output_format"
            android:textColor="@color/textcolor"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/format_spinner"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/spinner_bg"
            android:popupBackground="#222222" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/filename_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/output_filename"
            app:hintEnabled="true"
            app:hintTextColor="#FF676262">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/filename_input"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="payload" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/generate_payload"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/generate"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/payload_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#222222"
            android:gravity="bottom"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:textColor="@color/white"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
