<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:paddingBottom="20dp"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:background="@drawable/rectangle"
        android:layout_gravity="center"
        android:alpha="0.4"
        android:layout_marginTop="10dp"/>

    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:background="@drawable/circle_gradient"
        android:gravity="center">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:lottie_autoPlay="true"
            app:lottie_rawRes="@raw/wifi_dongle"
            app:lottie_speed="0.4" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/montserrat"
        android:text="@string/usb"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/usb_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="Usbinfo"
        android:textColor="@color/text_secondary"
        android:textIsSelectable="true"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/change_listen"
        style="@style/MonsButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="@color/primary"
        android:text="Change scan interface"
        android:textColor="@color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/change_deauth"
        style="@style/MonsButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/accent"
        android:text="Change deauth interface"
        android:textColor="@color/white" />
</LinearLayout>
