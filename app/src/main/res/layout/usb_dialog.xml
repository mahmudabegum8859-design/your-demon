<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:paddingBottom="24dp"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Neon gradient drag handle -->
            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:background="@drawable/bg_nav_indicator"
                android:layout_gravity="center"
                android:alpha="0.9"
                android:layout_marginTop="12dp"/>

            <!-- Glowing icon chip -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:layout_marginTop="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="65dp"
                    app:cardElevation="10dp"
                    app:strokeColor="#59F5A524"
                    app:strokeWidth="1.5dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient"
                        android:gravity="center">

                        <com.airbnb.lottie.LottieAnimationView
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            app:lottie_autoPlay="true"
                            app:lottie_rawRes="@raw/wifi_dongle"
                            app:lottie_speed="0.4" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/montserrat"
                android:letterSpacing="0.06"
                android:text="@string/usb"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/usb_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="center"
                android:padding="12dp"
                android:text="Usbinfo"
                android:textColor="@color/accent_light"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_listen"
                style="@style/Widget.YourDemon.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="Change scan interface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/change_deauth"
                style="@style/Widget.YourDemon.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:text="Change deauth interface" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
