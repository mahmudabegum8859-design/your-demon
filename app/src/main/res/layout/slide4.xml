<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slide_layout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:gravity="center"
    android:background="@drawable/bg_full_gradient"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/slide_img"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/terminal"
        android:tint="@color/primary"
        android:padding="34dp"
        android:background="@drawable/circle_white"
        android:elevation="10dp"
        android:layout_gravity="center_horizontal" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/slide_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="@font/montserrat"
        android:text="@string/term_title"
        android:textColor="@color/slide_text"
        android:gravity="center"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/slide_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:textColor="@color/slide_text_soft"
        android:text="@string/alpine_linux_termux_exit"
        android:textAllCaps="false"
        android:textSize="17sp"
        android:fontFamily="@font/montserrat"
        android:typeface="normal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/slide_button"
        style="@style/MonsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/yeah_ok"
        app:icon="@drawable/bolt"
        app:iconTint="@color/primary"
        android:backgroundTint="@color/primary"
        android:textColor="@color/text_on_primary"
        app:cornerRadius="16dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/slide_button_no"
        style="@style/MonsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/thx_no"
        app:icon="@drawable/bolt"
        app:iconTint="@color/text_on_primary"
        android:backgroundTint="#2AFFFFFF"
        android:textColor="@color/slide_text"
        app:cornerRadius="16dp"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/slide_install_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:indicatorColor="@color/primary"
        app:trackColor="#33FFFFFF"
        app:trackCornerRadius="6dp"
        app:trackThickness="6dp" />

    <TextView
        android:id="@+id/slide_progress_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:gravity="right"
        android:text="0/100"
        android:visibility="gone"
        android:textColor="@color/slide_text"
        android:textSize="13sp"
        android:fontFamily="monospace" />
</LinearLayout>
