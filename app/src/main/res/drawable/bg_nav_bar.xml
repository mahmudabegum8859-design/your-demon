<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ambient glow strip behind the bar -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26F5A524" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
        </shape>
    </item>
    <!-- Glass body -->
    <item
        android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6171310"
                android:endColor="#F20B0B0D" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#3DF5A524" />
        </shape>
    </item>
</layer-list>
