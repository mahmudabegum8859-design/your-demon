<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ INPUTS (Dark Ops) ============ -->
    <!-- Plain EditText — dark rounded field with subtle border -->
    <style name="Widget.YourDemon.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:fontFamily">@font/montserrat</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- TextInputLayout — dark filled box, violet stroke, cyan focus -->
    <style name="Widget.YourDemon.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_bg</item>
        <!-- ColorStateList: violet stroke by default, cyan when focused -->
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="android:fontFamily">@font/montserrat</item>
    </style>

    <!-- ============ BUTTONS (Dark Ops) ============ -->
    <!-- Primary — violet→cyan gradient with glow edge -->
    <style name="Widget.YourDemon.Button.Primary" parent="MonsButton">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Outline / ghost — transparent with neon cyan border -->
    <style name="Widget.YourDemon.Button.Outline" parent="MonsButton">
        <item name="android:background">@drawable/bg_btn_outline</item>
        <item name="android:textColor">@color/accent_light</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Danger — neon red gradient -->
    <style name="Widget.YourDemon.Button.Danger" parent="MonsButton">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Success — neon green gradient -->
    <style name="Widget.YourDemon.Button.Success" parent="MonsButton">
        <item name="android:background">@drawable/bg_btn_success</item>
        <item name="android:textColor">@color/background</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- ============ BADGES / LABELS ============ -->
    <!-- Small uppercase mono badge (terminal vibe) -->
    <style name="Text.Badge" parent="android:Widget.Material.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_light</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
